# Copiar a .env y completar. Nunca subir .env al repositorio.

# ---------- App registrada en Azure (Entra ID) ----------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Solo se usa con MAIL_AUTH=aplicacion
AZURE_CLIENT_SECRET=

# ---------- Correo ----------
MAIL_SENDER=remitente@gigafibra.co
# Envío: aplicacion (permiso de aplicación Mail.Send, requiere administrador de Azure)
#        delegado   (Mail.Send delegado: la cuenta de MAIL_SENDER inicia sesión una vez con un código)
MAIL_AUTH=delegado

# Carpeta de salida (Excel, log y estado de envíos)
OUTPUT_DIR=./reportes

# ---------- API de ERPNext ----------
# Claves: ERPNext > Usuario > Configuración de API > Generar claves (lectura de Subscription)
ERPNEXT_URL=https://next.gigafibra.co
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=GIGA FIBRA SAS

# ---------- Reporte de abonados TV (reporte_planes_tv.py) ----------
# Destinatarios y copias separados por ;
TV_MAIL_TO=destinatario@gigafibra.co
TV_MAIL_CC=
# Asunto y mensaje. Variables: {mes} {año} {fecha_corte} {total}
TV_MAIL_SUBJECT=Reporte de Número de Abonados TV {mes} {año}
TV_MENSAJE=./mensaje_tv.txt
# Firma: imagen (.jpg/.png) o el .htm de una firma de Outlook. TV_FIRMA_ANCHO aplica a imágenes.
TV_FIRMA=./firma.jpg
TV_FIRMA_ANCHO=421
TV_PLANTILLA_HTML=./plantilla_tv.html
# Planes del reporte en orden de prioridad (separados por ;). Si una suscripción tiene dos,
# queda el primero de la lista. Firestick cuenta como TV aunque en ERPNext tenga TV = 0.
TV_PLANES=Giga Fibra TV + WinSports + 2 SetBox - Nov-2025;Giga Fibra TV + WinSports + 1 SetBox - Jan-2025;Giga Fibra TV + 1 SetBox - Set-2024;Giga Fibra TV + 1 SetBox - May-2024;Firestick

# ---------- report_mailer.py (plantilla genérica original, no la usa el reporte de TV) ----------
MAIL_TO=
DB_URL=mysql+pymysql://usuario:clave@host:3306/basedatos
TEMPLATE_PATH=./plantilla.html
INLINE_IMAGES=logo=./firma.jpg
